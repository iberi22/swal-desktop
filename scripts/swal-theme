def apply_theme(theme_id):
    themes = get_themes()
    if theme_id not in themes:
        print(f"Error: Theme '{theme_id}' not found. Available: {', '.join(themes.keys())}")
        return False

    theme = themes[theme_id]

    with open(CURRENT_THEME_FILE, "w") as f:
        json.dump(theme, f, indent=2)

    scss_content = generate_scss(theme)
    with open(EWW_SCSS_FILE, "w") as f:
        f.write(scss_content)

    hypr = theme.get("hyprland", {})
    if "active_border" in hypr:
        subprocess.run(["hyprctl", "keyword", "general:col.active_border", hypr["active_border"]], capture_output=True)
    if "inactive_border" in hypr:
        subprocess.run(["hyprctl", "keyword", "general:col.inactive_border", hypr["inactive_border"]], capture_output=True)

    # Non-blocking reload to prevent IPC deadlock when invoked from inside an Eww button
    subprocess.Popen(["eww", "reload"])
    subprocess.Popen(["notify-send", "SWAL Theme Switcher", f"Tema aplicado: {theme.get('name', theme_id)}"])
    print(f"✓ Theme successfully switched to: {theme.get('name', theme_id)} ({theme_id})")
    return True


def run_rofi_picker():
    themes = get_themes()
    cur = get_current_theme().get("id", "")
    items = []
    id_map = {}
    for tid, t in themes.items():
        name = t.get("name", tid)
        icon = "● " if tid == cur else "○ "
        label = f"{icon}{name} ({tid})"
        items.append(label)
        id_map[label] = tid

    menu_input = "\n".join(items)
    try:
        proc = subprocess.Popen(
            ["rofi", "-dmenu", "-i", "-p", "🎨 SWAL Theme", "-theme-str", "window{width:420px;} listview{lines:5;}"],
            stdin=subprocess.PIPE,
            stdout=subprocess.PIPE,
            text=True
        )
        out, _ = proc.communicate(input=menu_input)
        selected = out.strip()
        if selected in id_map:
            apply_theme(id_map[selected])
    except Exception as e:
        print(f"Rofi error: {e}")


def main():
    parser = argparse.ArgumentParser(description="SWAL Dynamic Theme Engine")
    sub = parser.add_subparsers(dest="cmd")

    sub.add_parser("list", help="List all available themes")
    sub.add_parser("current", help="Show current active theme")
    sub.add_parser("picker", help="Open interactive Rofi theme selector")

    sw = sub.add_parser("switch", help="Switch active theme")
    sw.add_argument("name", help="Theme identifier (e.g. hive-dark, cyber-neon, nord-swal)")

    cr = sub.add_parser("create", help="Scaffold a new theme")
    cr.add_argument("name", help="New theme ID")
    cr.add_argument("--base", default="hive-dark", help="Base theme to clone from")

    args = parser.parse_args()

    if args.cmd == "list":
        themes = get_themes()
        cur = get_current_theme().get("id", "")
        print("Available SWAL Themes:")
        for tid, t in themes.items():
            mark = "● [ACTIVE]" if tid == cur else "○"
            print(f"  {mark} {tid:<16} — {t.get('name', tid)} (v{t.get('version', '1.0')})")

    elif args.cmd == "current":
        cur = get_current_theme()
        print(json.dumps(cur, indent=2))

    elif args.cmd == "picker":
        run_rofi_picker()

    elif args.cmd == "switch":
        apply_theme(args.name)

    elif args.cmd == "create":
        themes = get_themes()
        base = themes.get(args.base, themes.get("hive-dark", {}))
        new_theme = dict(base)
        new_theme["id"] = args.name
        new_theme["name"] = f"SWAL {args.name.capitalize()}"
        target_path = os.path.join(THEMES_DIR, f"{args.name}.json")
        with open(target_path, "w") as f:
            json.dump(new_theme, f, indent=2)
        print(f"✓ Created new theme template: {target_path}")

    else:
        parser.print_help()


if __name__ == "__main__":
    main()
