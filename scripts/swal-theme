#!/usr/bin/env python3
"""swal-theme — Dynamic Theme Manager and Dispatcher for SWAL Desktop."""
import argparse
import glob
import json
import os
import subprocess
import sys

THEMES_DIR = os.path.expanduser("~/.config/swal/themes")
CURRENT_THEME_FILE = os.path.expanduser("~/.config/swal/current_theme.json")
EWW_SCSS_FILE = os.path.expanduser("~/.config/eww/eww.scss")


def get_themes():
    themes = {}
    for path in sorted(glob.glob(os.path.join(THEMES_DIR, "*.json"))):
        try:
            with open(path) as f:
                data = json.load(f)
                tid = data.get("id") or os.path.splitext(os.path.basename(path))[0]
                themes[tid] = data
        except Exception:
            continue
    return themes


def get_current_theme():
    if os.path.exists(CURRENT_THEME_FILE):
        try:
            with open(CURRENT_THEME_FILE) as f:
                return json.load(f)
        except Exception:
            pass
    themes = get_themes()
    return themes.get("hive-dark") or themes.get("cyber-neon") or {}


