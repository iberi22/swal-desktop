{
  "theme": {
    "mode": "dark",
    "light": "One Light",
    "dark": "Iberi22 Dark EyeCare"
  },
  "buffer_font_family": "FiraCode Nerd Font",
  "buffer_font_size": 15,
  "buffer_line_height": "comfortable",
  "ui_font_family": "FiraCode Nerd Font",
  "ui_font_size": 14,
  "project_panel": {
    "dock": "left",
    "default_width": 280,
    "button": true,
    "auto_reveal_entries": true,
    "auto_fold_dirs": true,
    "hide_root": false,
    "show_staged_changes": true,
    "indent_size": 20
  },
  "outline_panel": {
    "dock": "right",
    "default_width": 240,
    "button": true
  },
  "collaboration_panel": {
    "dock": "left",
    "button": true
  },
  "terminal": {
    "dock": "bottom",
    "default_width": 640,
    "default_height": 320,
    "button": true,
    "font_size": 13,
    "line_height": "comfortable"
  },
  "assistant": {
    "dock": "right",
    "default_width": 360,
    "button": true
  },
  "vim_mode": false,
  "tab_bar": {
    "show": true
  },
  "toolbar": {
    "breadcrumbs": true,
    "quick_actions": true
  },
  "scroll_beyond_last_line": "one_page",
  "show_whitespaces": "none",
  "ensure_final_newline_on_save": true,
  "remove_trailing_whitespace_on_save": true,
  "format_on_save": "off",
  "soft_wrap": "none",
  "preferred_line_length": 100,
  "hard_tabs": false,
  "tab_size": 2,
  "show_completions_on_input": true,
  "show_completion_documentation": true,
  "auto_update": false,
  "telemetry": {
    "diagnostics": false,
    "metrics": false
  },
  "gutter": {
    "line_numbers": true
  },
  "indent_guides": {
    "enabled": true,
    "coloring": "indent_aware"
  }
}
